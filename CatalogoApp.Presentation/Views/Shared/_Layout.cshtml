<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GirlGaming</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm">
            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand" asp-controller="Catalogo" asp-action="Index">
                    🌸 GirlGaming
                </a>

                <!-- Toggler móvil -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Links izquierda -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                        </li>
                    </ul>

                    <!-- Links derecha -->
                    <ul class="navbar-nav align-items-center gap-1">
                        @if (Context.Session.GetString("UsuarioLogueado") != null)
                        {
                            <!-- Usuario logueado -->
                            <li class="nav-item">
                                <span class="nav-user">
                                    ✿ @Context.Session.GetString("UsuarioLogueado")
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link agregar"
                                   asp-controller="Catalogo" asp-action="Agregar">
                                    + Agregar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-logout"
                                   asp-controller="Usuario" asp-action="Logout">
                                    Salir
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- Sin sesión -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Usuario" asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link agregar"
                                   asp-controller="Usuario" asp-action="Registro">
                                    Registrarse
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido principal -->
    <div class="container" style="margin-top: 2.2rem;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <div class="container">
            Ángela Rojas · &copy; 2026 GirlGaming
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
